# /etc/ghacc.conf
# 下面的数组决定加速源尝试顺序。
GHACC_MIRRORS=(
  "https://ghfast.top/"
  "https://gh-proxy.com/"
  "https://ghproxy.net/"
  "https://gh.llkk.cc/"
)

# 进程环境变量会在读取本文件后覆盖下面 4 个标量配置。
# 导出 GHACC_DOWNLOAD_DIR="" 表示使用当前目录。
GHACC_TIMEOUT=8
GHACC_DOWNLOAD_DIR=""
GHACC_AUTO_SELECT=1
GHACC_FALLBACK_DIRECT=1

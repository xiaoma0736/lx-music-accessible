<Project>
  <ItemGroup>
    <PackageReference Include="IsExternalInit" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="IndexRange" Version="1.0.3" />
    <PackageReference Include="System.Memory" Version="4.6.0" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Text.Json, Version=8.0.0.0, Culture=neutral, PublicKeyToken=cc7b13ffcd2ddd51, processorArchitecture=MSIL" Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework' And '$(MSBuildProjectName)' != 'LXMusicAccessible.Setup'">
      <HintPath>$(PkgSystem_Text_Json)\lib\netstandard2.0\System.Text.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Net.Http" Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'" />
    <Reference Include="System.IO.Compression" Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'" />
    <Reference Include="System.IO.Compression.FileSystem" Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'" />
    <Compile Include="$(MSBuildThisFileDirectory)src\Common\*.cs" LinkBase="Common" Condition="'$(MSBuildProjectName)' != 'LXMusicAccessible.Tests' And '$(MSBuildProjectName)' != 'LXMusicAccessible.App'" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System.Net.Http" />
  </ItemGroup>
</Project>

<Window x:Class="LXMusicAccessible.App.DownloadManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LXMusicAccessible.App"
        Title="下载管理"
        Width="760" Height="600" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="DownloadCancelBtn" Content="取消选中" Width="90" Height="28" Margin="0,0,5,0"
                    Click="DownloadCancelBtn_Click"/>
            <Button x:Name="DownloadRetryBtn" Content="重试" Width="70" Height="28" Margin="0,0,5,0"
                    Click="DownloadRetryBtn_Click"/>
            <Button x:Name="DownloadOpenFolderBtn" Content="打开下载文件夹" Width="120" Height="28" Margin="0,0,5,0"
                    Click="DownloadOpenFolderBtn_Click"/>
            <Button x:Name="DownloadClearBtn" Content="清空" Width="70" Height="28"
                    Click="DownloadClearBtn_Click"/>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="下载任务">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="EmptyDownloadText" Text="暂无下载任务" Margin="6,4"
                           AutomationProperties.LiveSetting="Polite"/>
                <local:SingleReadListBox x:Name="DownloadTaskList" Grid.Row="1" MinHeight="300"
                                         AutomationProperties.Name="下载任务">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayName}" Width="380" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding ProgressText}" Width="70"/>
                                <TextBlock Text="{Binding StatusText}" Width="70"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </local:SingleReadListBox>
            </Grid>
        </GroupBox>
    </Grid>
</Window>

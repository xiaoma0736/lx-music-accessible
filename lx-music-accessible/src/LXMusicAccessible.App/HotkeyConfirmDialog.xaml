<Window x:Class="LXMusicAccessible.App.HotkeyConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷键设置完成" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        AutomationProperties.Name="快捷键设置完成对话框">
    <StackPanel Margin="24">
        <TextBlock x:Name="MessageText" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"
                   AutomationProperties.Name="设置结果提示"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
            <Button x:Name="OkButton" Content="确定" Width="96" Height="34"
                    Click="Ok_Click" IsDefault="True" IsCancel="True"
                    AutomationProperties.Name="确定" IsTabStop="True"/>
        </StackPanel>
    </StackPanel>
</Window>

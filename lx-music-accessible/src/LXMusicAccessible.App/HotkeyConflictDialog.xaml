<Window x:Class="LXMusicAccessible.App.HotkeyConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷键冲突提示" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        AutomationProperties.Name="快捷键冲突提示对话框">
    <StackPanel Margin="24">
        <TextBlock x:Name="MessageText" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"
                   AutomationProperties.Name="冲突提示信息"/>
        <TextBlock x:Name="DetailText" FontSize="14" Margin="0,10,0,0" TextWrapping="Wrap"
                   AutomationProperties.Name="冲突快捷键列表"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
            <Button x:Name="ReregisterButton" Content="重新设置" Width="120" Height="34" Margin="0,0,16,0"
                    Click="Reregister_Click" IsDefault="True"
                    AutomationProperties.Name="重新设置" IsTabStop="True"/>
            <Button x:Name="KeepButton" Content="保留（仅程序内生效）" Width="190" Height="34"
                    Click="Keep_Click" IsCancel="True"
                    AutomationProperties.Name="保留（仅程序内生效）" IsTabStop="True"/>
        </StackPanel>
    </StackPanel>
</Window>
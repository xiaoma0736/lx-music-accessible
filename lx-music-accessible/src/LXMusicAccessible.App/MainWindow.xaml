                                       AutomationProperties.Name="音源管理标题"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="ImportLocalSourceBtn" Content="从本地导入" Width="100" Height="28" Margin="0,0,5,0" KeyboardNavigation.TabIndex="76"
                                        AutomationProperties.Name="从本地导入音源" Click="ImportLocalSourceBtn_Click" IsTabStop="True"/>
                                <Button x:Name="ImportNetworkSourceBtn" Content="从网络导入" Width="100" Height="28" Margin="0,0,5,0" KeyboardNavigation.TabIndex="77"
                                        AutomationProperties.Name="从网络导入音源" Click="ImportNetworkSourceBtn_Click" IsTabStop="True"/>
                                <Button x:Name="RefreshSourcesBtn" Content="刷新" Width="70" Height="28" KeyboardNavigation.TabIndex="78"
                                        AutomationProperties.Name="刷新音源列表" Click="RefreshSourcesBtn_Click" IsTabStop="True"/>
                            </StackPanel>

                            <GroupBox Header="音源接口列表" AutomationProperties.Name="音源接口列表区域">
                                <local:SingleReadListBox x:Name="SourceList" MinHeight="420" KeyboardNavigation.TabIndex="79"
                                         AutomationProperties.Name="音源接口列表"
                                         AutomationProperties.HelpText="上下方向键浏览，右键或应用键打开操作菜单，回车查看详情，删除键删除"
                                         ContextMenu="{StaticResource SourceContextMenu}"
                                         KeyDown="SourceList_KeyDown"
                                         IsTabStop="False">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" Width="220" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Version}" Width="70" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding TypeText}" Width="70"/>
                                                <TextBlock Text="{Binding StatusText}" Width="90"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </local:SingleReadListBox>
                            </GroupBox>
                        </StackPanel>
                    </local:SafeScrollViewer>
                </TabItem>
            </TabControl>

            <!-- ===== 右侧信息面板 ===== -->
            <StackPanel Grid.Column="1" Margin="10" AutomationProperties.Name="信息面板" x:Name="RightPanel">
                <GroupBox Header="正在播放" AutomationProperties.Name="正在播放信息">
                    <StackPanel>
                        <TextBlock x:Name="CurrentTitle" Text="未播放"
                                   AutomationProperties.Name="当前歌曲标题" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock x:Name="CurrentArtist" Text=""
                                   AutomationProperties.Name="当前歌手" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock x:Name="CurrentAlbum" Text=""
                                   AutomationProperties.Name="当前专辑" TextWrapping="Wrap"/>
                        <TextBlock x:Name="CurrentPlayModeText" Text="播放模式：顺序播放"
                                   AutomationProperties.Name="当前播放模式" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock x:Name="PositionText" Text="00:00 / 00:00"
                                   AutomationProperties.Name="播放时间" Margin="0,8,0,0"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </Grid>

        <!-- ===== 底部状态栏 ===== -->
        <StatusBar Grid.Row="2" AutomationProperties.Name="状态栏">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪" AutomationProperties.Name="状态信息"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="TimeText" Text="" AutomationProperties.Name="当前时间"/>
            </StatusBarItem>
        </StatusBar>

        <!-- 无障碍实时区域：NVDA/讲述人/JAWS 播报用 -->
        <local:AnnouncementTextBlock x:Name="LiveRegion" Width="1" Height="1" Opacity="0" IsHitTestVisible="False"
                   AutomationProperties.LiveSetting="Polite"
                   VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
    </Grid>
</Window>



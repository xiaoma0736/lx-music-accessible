<Window x:Class="LXMusicAccessible.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LXMusicAccessible.App"
        mc:Ignorable="d"
        Title="落雪音乐 无障碍版" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        KeyboardNavigation.TabNavigation="Continue"
        KeyboardNavigation.DirectionalNavigation="None"
        PreviewKeyDown="Window_PreviewKeyDown" KeyDown="Window_KeyDown" KeyUp="Window_KeyUp">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 菜单栏（仅 Alt 访问，不参与 Tab 导航） ===== -->
        <Menu Grid.Row="0" x:Name="MainMenu"
              KeyboardNavigation.TabNavigation="None">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="隐藏/显示窗口(_H)" Click="HideShowWindowMenu_Click"/>
                <Separator/>
                <MenuItem Header="退出(_X)" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="播放(_P)">
                <MenuItem x:Name="MenuPlayPauseItem" Header="播放/暂停（F5）" Click="PlayPauseButton_Click"/>
                <MenuItem Header="停止（F6）" Click="StopButton_Click"/>
                <MenuItem Header="上一首" Click="PreviousButton_Click"/>
                <MenuItem Header="下一首" Click="NextButton_Click"/>
                <Separator/>
                <MenuItem Header="快退十秒（F7）" Click="RewindMenu_Click"/>
                <MenuItem Header="快进十秒（F8）" Click="ForwardMenu_Click"/>
                <Separator/>
                <MenuItem Header="音量减（F9）" Click="VolumeDownMenu_Click"/>
                <MenuItem Header="音量加（F10）" Click="VolumeUpMenu_Click"/>
                <MenuItem Header="上一个播放设备（F11）" Click="PrevDeviceMenu_Click"/>
                <MenuItem Header="下一个播放设备（F12）" Click="NextDeviceMenu_Click"/>
                <Separator/>
                <MenuItem Header="歌词延后（Shift+F7）" Click="LyricDelayMenu_Click"/>
                <MenuItem Header="歌词提前（Shift+F8）" Click="LyricAdvanceMenu_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuPlayModeItem" Header="播放模式（F1）" Click="PlayModeButton_Click"/>
                <MenuItem Header="下载（F2）" Click="DownloadMenu_Click"/>
            </MenuItem>
            <MenuItem Header="浏览(_B)">
                <MenuItem Header="搜索(_S)" Click="MenuNavigateToSearch"/>
                <MenuItem Header="播放列表(_L)" Click="MenuNavigateToPlaylist"/>
                <MenuItem Header="导入个人歌单(_I)" Click="MenuNavigateToImport"/>
                <MenuItem Header="分类歌单(_C)" Click="MenuNavigateToCategory"/>
                <MenuItem Header="排行榜(_R)" Click="MenuNavigateToRanking"/>
                <MenuItem Header="歌词(_G)" Click="MenuNavigateToLyrics"/>
                <MenuItem Header="下载管理(_D)" Click="MenuNavigateToDownload"/>
            </MenuItem>
            <MenuItem Header="工具(_T)">
                <MenuItem Header="音源管理(_M)" Click="MenuOpenSourceManager"/>
                <MenuItem Header="设置(_S)" Click="MenuNavigateToSettings"/>
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="使用说明(_U)" Click="UserGuide_Click"/>
                <MenuItem Header="赞助(_S)" Click="Sponsor_Click"/>
                <MenuItem Header="关于(_A)" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- ===== 主内容区 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0" x:Name="MainTabControl"
                        KeyboardNavigation.TabNavigation="Local"
                        KeyboardNavigation.DirectionalNavigation="Contained"
                        SelectionChanged="MainTabControl_SelectionChanged"
                        Margin="5">
                <!-- ===== 标签1：搜索 ===== -->
                <TabItem Header="搜索"
                         KeyboardNavigation.TabNavigation="Cycle"
                         KeyboardNavigation.DirectionalNavigation="None">
                    <local:SafeScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" IsTabStop="False">
                        <StackPanel Margin="15">
                            <TextBlock Text="搜索音乐" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Label Content="音源：" Target="{Binding ElementName=SearchSourceCombo}"
                                       VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                                <ComboBox x:Name="SearchSourceCombo" AutomationProperties.Name="搜索音源" Width="140" Height="28" Margin="0,0,15,0" KeyboardNavigation.TabIndex="10" SelectionChanged="SearchSourceCombo_SelectionChanged" IsTabStop="True">
                                    <ComboBoxItem Content="全部音源" Tag="all" IsSelected="True"/>
                                    <ComboBoxItem Content="网易云音乐" Tag="netease"/>
                                    <ComboBoxItem Content="QQ音乐" Tag="qq"/>
                                    <ComboBoxItem Content="酷狗音乐" Tag="kg"/>
                                    <ComboBoxItem Content="酷我音乐" Tag="kw"/>
                                    <ComboBoxItem Content="咪咕音乐" Tag="migu"/>
                                </ComboBox>

                                <Label Content="类型：" Target="{Binding ElementName=SearchTypeComboBox}"
                                       VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                                <ComboBox x:Name="SearchTypeComboBox" AutomationProperties.Name="搜索类型" Width="100" Height="28" KeyboardNavigation.TabIndex="11" IsTabStop="True">
                                    <ComboBoxItem Content="歌曲" Tag="song" IsSelected="True"/>
                                    <ComboBoxItem Content="歌手" Tag="artist"/>
                                    <ComboBoxItem Content="专辑" Tag="album"/>
                                </ComboBox>
                            </StackPanel>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SearchBox" Grid.Column="0" Height="30" Margin="0,0,10,0" KeyboardNavigation.TabIndex="12"
                                         AutomationProperties.Name="搜索关键词"
                                         KeyDown="SearchBox_KeyDown" IsTabStop="True"/>
                                <Button x:Name="SearchButton" Grid.Column="1" Content="搜索" Width="80" Height="30" KeyboardNavigation.TabIndex="13" Click="SearchButton_Click" IsTabStop="True"/>
                                <Button x:Name="SearchClearButton" Grid.Column="2" Content="清空" Width="80" Height="30" KeyboardNavigation.TabIndex="14" Click="SearchClearButton_Click" IsTabStop="True"/>
                            </Grid>

                            <GroupBox Header="搜索结果">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <local:SingleReadListBox x:Name="SearchResultsList" Grid.Row="0" MinHeight="350" KeyboardNavigation.TabIndex="15"
                                             AutomationProperties.Name="搜索结果"
                                             ContextMenuOpening="SongList_ContextMenuOpening"
                                             PreviewMouseRightButtonDown="SongList_PreviewMouseRightButtonDown"
                                             MouseDoubleClick="SearchResultsList_MouseDoubleClick"
                                             KeyDown="SearchResultsList_KeyDown" IsTabStop="False">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" Width="280" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Artist}" Width="180" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Album}" Width="180" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Duration}" Width="70"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </local:SingleReadListBox>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                        <local:InvisibleToScreenReaderButton x:Name="SearchPrevPageBtn" Content="上一页" Width="80" Height="28" KeyboardNavigation.TabIndex="16" Click="SearchPrevPageBtn_Click" IsTabStop="False"/>
                                        <local:InvisibleToScreenReaderTextBlock x:Name="SearchPageInfo" Text="第 1 页" VerticalAlignment="Center" Margin="10,0"/>
                                        <local:InvisibleToScreenReaderButton x:Name="SearchNextPageBtn" Content="下一页" Width="80" Height="28" KeyboardNavigation.TabIndex="17" Click="SearchNextPageBtn_Click" IsTabStop="False"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </local:SafeScrollViewer>
                </TabItem>
                                <!-- ===== 标签2：播放列表（本地收藏/在线收藏） ===== -->
                                <TabItem Header="播放列表"
                         KeyboardNavigation.TabNavigation="Cycle"
                         KeyboardNavigation.DirectionalNavigation="None">
                    <local:SafeScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" IsTabStop="False">
                        <StackPanel Margin="15">
                            <TextBlock Text="音乐收藏" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>

                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="在线音乐收藏：可收藏单曲或整个歌单，支持新建歌单分组管理。"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="NewOnlinePlaylistBtn" Content="新建歌单" Width="90" Height="28" Margin="0,0,5,0" KeyboardNavigation.TabIndex="29" Click="NewOnlinePlaylistBtn_Click" IsTabStop="True"/>
                                    <Button x:Name="RenameOnlinePlaylistBtn" Content="重命名歌单" Width="100" Height="28" Margin="0,0,5,0" KeyboardNavigation.TabIndex="30" Click="RenameOnlinePlaylistBtn_Click" IsTabStop="True"/>
                                    <Button x:Name="DeleteOnlinePlaylistBtn" Content="删除歌单" Width="90" Height="28" Margin="0,0,5,0" KeyboardNavigation.TabIndex="31" Click="DeleteOnlinePlaylistBtn_Click" IsTabStop="True"/>
                                    <Button x:Name="FavRefreshBtn" Content="刷新" Width="70" Height="28" Margin="0,0,5,0" KeyboardNavigation.TabIndex="32" Click="FavRefreshBtn_Click" IsTabStop="True"/>
                                    <Button x:Name="FavRemoveBtn" Content="从歌单移除" Width="100" Height="28" Margin="0,0,5,0" KeyboardNavigation.TabIndex="33" Click="FavRemoveBtn_Click" IsTabStop="True"/>
                                    <Button x:Name="FavClearBtn" Content="清空歌单" Width="90" Height="28" KeyboardNavigation.TabIndex="34" Click="FavClearBtn_Click" IsTabStop="True"/>
                                    <TextBlock x:Name="FavoriteCountText" Text="共 0 首" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="250"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <GroupBox Grid.Column="0" Header="在线歌单" Margin="0,0,8,0">
                                        <ListBox x:Name="OnlinePlaylistList" MinHeight="300" DisplayMemberPath="Name" KeyboardNavigation.TabIndex="35"
                                                 AutomationProperties.Name="在线歌单"
                                                 SelectionChanged="OnlinePlaylistList_SelectionChanged"
                                                 KeyDown="OnlinePlaylistList_KeyDown" IsTabStop="False">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                    </GroupBox>
                                    <GroupBox Grid.Column="1" Header="在线歌曲">
                                        <local:SingleReadListBox x:Name="FavoriteSongsList" MinHeight="300" KeyboardNavigation.TabIndex="36"
                                            AutomationProperties.Name="在线歌曲"
                                            ContextMenuOpening="SongList_ContextMenuOpening"
                                            PreviewMouseRightButtonDown="SongList_PreviewMouseRightButtonDown"
                                            MouseDoubleClick="FavoriteSongsList_MouseDoubleClick"
                                            KeyDown="FavoriteSongsList_KeyDown" IsTabStop="False">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" Width="280" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Artist}" Width="180" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Album}" Width="180" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Duration}" Width="70"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </local:SingleReadListBox>
                                    </GroupBox>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </local:SafeScrollViewer>
                </TabItem>

                <!-- ===== 标签：导入个人歌单（并入主界面） ===== -->
                <TabItem Header="导入个人歌单"
                         KeyboardNavigation.TabNavigation="Cycle"
                         KeyboardNavigation.DirectionalNavigation="None">
                    <ContentControl x:Name="PlaylistImportHost"/>
                </TabItem>

<!-- ===== 标签3：分类歌单 ===== -->
                <TabItem Header="分类歌单"
                         KeyboardNavigation.TabNavigation="Cycle"
                         KeyboardNavigation.DirectionalNavigation="None">
                    <local:SafeScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" IsTabStop="False">
                        <StackPanel Margin="15">
                            <TextBlock Text="分类歌单" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Label Content="音源：" Target="{Binding ElementName=CategorySourceCombo}"
                                       VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                                <ComboBox x:Name="CategorySourceCombo" AutomationProperties.Name="分类歌单音源" Width="140" Height="28" Margin="0,0,10,0" KeyboardNavigation.TabIndex="31"
                                          SelectionChanged="CategorySourceCombo_SelectionChanged" KeyDown="CategorySourceCombo_KeyDown" IsTabStop="True">
                                    <ComboBoxItem Content="网易云音乐" Tag="netease" IsSelected="True"/>
                                    <ComboBoxItem Content="QQ音乐" Tag="qq"/>
                                    <ComboBoxItem Content="酷狗音乐" Tag="kg"/>
                                    <ComboBoxItem Content="酷我音乐" Tag="kw"/>
                                    <ComboBoxItem Content="咪咕音乐" Tag="migu"/>
                                </ComboBox>
                                <Button x:Name="CategoryRefreshBtn" Content="刷新" Width="70" Height="28" KeyboardNavigation.TabIndex="32" Click="CategoryRefreshBtn_Click" IsTabStop="True"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <GroupBox Grid.Column="0" Header="分类">
                                    <ListBox x:Name="CategoryList" KeyboardNavigation.TabIndex="33"
                                             AutomationProperties.Name="分类"
                                             DisplayMemberPath="Name"
                                             SelectionChanged="CategoryList_SelectionChanged"
                                             KeyDown="CategoryList_KeyDown" IsTabStop="False">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </GroupBox>
                                <GroupBox Grid.Column="1" Header="歌单" Margin="10,0,0,0">
                                    <ListBox x:Name="CategoryPlaylistsListBox" KeyboardNavigation.TabIndex="34"
                                             AutomationProperties.Name="歌单"
                                             DisplayMemberPath="Name"
                                             SelectionChanged="CategoryPlaylistsListBox_SelectionChanged"
                                             KeyDown="CategoryPlaylistsListBox_KeyDown"
                                             ContextMenuOpening="PlaylistList_ContextMenuOpening" IsTabStop="False">
                                        <ListBox.ContextMenu>
                                            <ContextMenu PreviewKeyUp="ContextMenu_PreviewKeyUp">
                                                <MenuItem Header="收藏整个歌单到在线收藏" Click="CategoryPlaylist_Favorite_Click"/>
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </GroupBox>
                                <GroupBox Grid.Column="2" Header="歌曲" Margin="10,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <local:SingleReadListBox x:Name="CategorySongsList" Grid.Row="0" KeyboardNavigation.TabIndex="35"
                                                 AutomationProperties.Name="歌单歌曲"
                                                 ContextMenuOpening="SongList_ContextMenuOpening"
                                                 PreviewMouseRightButtonDown="SongList_PreviewMouseRightButtonDown"
                                             MouseDoubleClick="CategorySongsList_MouseDoubleClick"
                                                 KeyDown="CategorySongsList_KeyDown" IsTabStop="False">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" Width="220" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Artist}" Width="150" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Album}" Width="140" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Duration}" Width="60"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </local:SingleReadListBox>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                            <local:InvisibleToScreenReaderButton x:Name="CategoryPrevPageBtn" Content="上一页" Width="80" Height="28" KeyboardNavigation.TabIndex="36" Click="CategoryPrevPageBtn_Click" IsTabStop="False"/>
                                            <local:InvisibleToScreenReaderTextBlock x:Name="CategoryPageInfo" Text="第 1 页" VerticalAlignment="Center" Margin="10,0"/>
                                            <local:InvisibleToScreenReaderButton x:Name="CategoryNextPageBtn" Content="下一页" Width="80" Height="28" KeyboardNavigation.TabIndex="36" Click="CategoryNextPageBtn_Click" IsTabStop="False"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>
                            </Grid>
                        </StackPanel>
                    </local:SafeScrollViewer>
                </TabItem>
                <!-- ===== 标签4：排行榜 ===== -->
                <TabItem Header="排行榜"
                         KeyboardNavigation.TabNavigation="Cycle"
                         KeyboardNavigation.DirectionalNavigation="None">
                    <local:SafeScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" IsTabStop="False">
                        <StackPanel Margin="15">
                            <TextBlock Text="音乐排行榜" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Label Content="音源：" Target="{Binding ElementName=RankingSourceCombo}"
                                       VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                                <ComboBox x:Name="RankingSourceCombo" AutomationProperties.Name="排行榜音源" Width="140" Height="28" Margin="0,0,10,0" KeyboardNavigation.TabIndex="40"
                                          SelectionChanged="RankingSourceCombo_SelectionChanged" KeyDown="RankingSourceCombo_KeyDown" IsTabStop="True">
                                    <ComboBoxItem Content="网易云音乐" Tag="netease" IsSelected="True"/>
                                    <ComboBoxItem Content="QQ音乐" Tag="qq"/>
                                    <ComboBoxItem Content="酷狗音乐" Tag="kg"/>
                                    <ComboBoxItem Content="酷我音乐" Tag="kw"/>
                                    <ComboBoxItem Content="咪咕音乐" Tag="migu"/>
                                </ComboBox>
                                <Button x:Name="RefreshRankingButton" Content="刷新" Width="70" Height="28" KeyboardNavigation.TabIndex="41" Click="RefreshRankingButton_Click" IsTabStop="True"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <GroupBox Grid.Column="0" Header="排行榜列表">
                                    <ListBox x:Name="RankingList" KeyboardNavigation.TabIndex="42"
                                             AutomationProperties.Name="排行榜"
                                             DisplayMemberPath="Name"
                                             SelectionChanged="RankingList_SelectionChanged"
                                             KeyDown="RankingList_KeyDown"
                                             ContextMenuOpening="PlaylistList_ContextMenuOpening" IsTabStop="False">
                                        <ListBox.ContextMenu>
                                            <ContextMenu PreviewKeyUp="ContextMenu_PreviewKeyUp">
                                                <MenuItem Header="收藏整个榜单到在线收藏" Click="Ranking_Favorite_Click"/>
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                    </ListBox>
                                </GroupBox>
                                <GroupBox Grid.Column="1" Header="榜单歌曲" Margin="10,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <local:SingleReadListBox x:Name="RankingSongsList" Grid.Row="0" KeyboardNavigation.TabIndex="43"
                                                 AutomationProperties.Name="榜单歌曲"
                                                 ContextMenuOpening="SongList_ContextMenuOpening"
                                                 PreviewMouseRightButtonDown="SongList_PreviewMouseRightButtonDown"
                                             MouseDoubleClick="RankingSongsList_MouseDoubleClick"
                                                 KeyDown="RankingSongsList_KeyDown" IsTabStop="False">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" Width="220" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Artist}" Width="150" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Album}" Width="140" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Duration}" Width="60"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </local:SingleReadListBox>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                            <local:InvisibleToScreenReaderButton x:Name="RankingPrevPageBtn" Content="上一页" Width="80" Height="28" KeyboardNavigation.TabIndex="44" Click="RankingPrevPageBtn_Click" IsTabStop="False"/>
                                            <local:InvisibleToScreenReaderTextBlock x:Name="RankingPageInfo" Text="第 1 页" VerticalAlignment="Center" Margin="10,0"/>
                                            <local:InvisibleToScreenReaderButton x:Name="RankingNextPageBtn" Content="下一页" Width="80" Height="28" KeyboardNavigation.TabIndex="45" Click="RankingNextPageBtn_Click" IsTabStop="False"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>
                            </Grid>
                        </StackPanel>
                    </local:SafeScrollViewer>
                </TabItem>

                <!-- ===== 标签5：设置 ===== -->
                <TabItem Header="设置"
                         KeyboardNavigation.TabNavigation="Cycle"
                         KeyboardNavigation.DirectionalNavigation="None">
                    <local:SafeScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" IsTabStop="False">
                        <StackPanel Margin="15">
                            <TextBlock Text="设置" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>

                            <GroupBox Header="播放设置" Margin="0,0,0,15">
                                <StackPanel Margin="10">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Label Content="默认播放音质：" Target="{Binding ElementName=DefaultQualityCombo}"
                                               VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="DefaultQualityCombo" AutomationProperties.Name="默认播放音质" Width="150" Height="28" KeyboardNavigation.TabIndex="60" SelectionChanged="DefaultQualityCombo_SelectionChanged" IsTabStop="True">
                                            <ComboBoxItem Content="128k 标准" Tag="128k" IsSelected="True"/>
                                            <ComboBoxItem Content="192k" Tag="192k"/>
                                            <ComboBoxItem Content="320k 高品质" Tag="320k"/>
                                            <ComboBoxItem Content="FLAC 无损" Tag="flac"/>
                                            <ComboBoxItem Content="FLAC 24bit 高解析" Tag="flac24bit"/>
                                            <ComboBoxItem Content="Hi-Res 高解析" Tag="hires"/>
                                            <ComboBoxItem Content="杜比全景声" Tag="atmos"/>
                                            <ComboBoxItem Content="杜比全景声增强" Tag="atmos_plus"/>
                                            <ComboBoxItem Content="母带级" Tag="master"/>
                                            <ComboBoxItem Content="至臻音效" Tag="jyeffect"/>
                                            <ComboBoxItem Content="至臻全景声" Tag="sky"/>
                                            <ComboBoxItem Content="杜比音效" Tag="dolby"/>
                                            <ComboBoxItem Content="至臻母带" Tag="jymaster"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <CheckBox x:Name="AutoPlayCheckBox" Content="自动播放" IsChecked="True" Margin="0,0,0,10" KeyboardNavigation.TabIndex="61" IsTabStop="True"/>
                                    <CheckBox x:Name="ShufflePlayCheckBox" Content="随机播放" IsChecked="False" Margin="0,0,0,10" KeyboardNavigation.TabIndex="62" Checked="ShufflePlayCheckBox_Changed" Unchecked="ShufflePlayCheckBox_Changed" IsTabStop="True"/>
                                    <CheckBox x:Name="RepeatPlayCheckBox" Content="循环播放" IsChecked="False" Margin="0,0,0,10" KeyboardNavigation.TabIndex="63" Checked="RepeatPlayCheckBox_Changed" Unchecked="RepeatPlayCheckBox_Changed" IsTabStop="True"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" KeyboardNavigation.TabIndex="63">
                                        <Label Content="按 Alt+F4 时：" Target="{Binding ElementName=CloseBehaviorCombo}"
                                               VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="CloseBehaviorCombo" AutomationProperties.Name="按 Alt+F4 时" Width="180" Height="28" KeyboardNavigation.TabIndex="64"
                                                  SelectionChanged="CloseBehaviorCombo_SelectionChanged" IsTabStop="True">
                                            <ComboBoxItem Content="关闭应用" Tag="close" IsSelected="True"/>
                                            <ComboBoxItem Content="隐藏到系统托盘" Tag="hide"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <TextBlock Text="提示：按 ESC 键可随时隐藏窗口到系统托盘，音乐继续播放；双击托盘图标恢复窗口。" 
                                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="第三方播放器" Margin="0,0,0,15">
                                <StackPanel Margin="10">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Label Content="播放器路径：" Target="{Binding ElementName=ThirdPartyPlayerPathBox}" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                                        <TextBox x:Name="ThirdPartyPlayerPathBox" AutomationProperties.Name="第三方播放器路径" Width="280" Height="28" Margin="0,0,8,0" KeyboardNavigation.TabIndex="65" LostKeyboardFocus="ThirdPartyPlayerPathBox_LostKeyboardFocus" PreviewKeyDown="SettingsPathBox_PreviewKeyDown" IsTabStop="True"/>
                                        <Button x:Name="BrowseThirdPartyPlayerBtn" Content="浏览..." Width="80" Height="28" KeyboardNavigation.TabIndex="66" Click="BrowseThirdPartyPlayerBtn_Click" IsTabStop="True"/>
                                    </StackPanel>
                                    <TextBlock Text="用于歌曲右键菜单“用第三方播放器播放”；在线歌曲将解析播放链接后交由该播放器播放。" TextWrapping="Wrap"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="歌词设置" Margin="0,0,0,15">
                                <StackPanel Margin="10">
                                    <CheckBox x:Name="LyricAnnounceCheckBox" Content="自动朗读当前歌词" IsChecked="True" Margin="0,0,0,10" KeyboardNavigation.TabIndex="67" Checked="LyricAnnounceCheckBox_Changed" Unchecked="LyricAnnounceCheckBox_Changed" IsTabStop="True"/>
                                    <CheckBox x:Name="LyricScrollCheckBox" Content="歌词自动滚动到当前句" IsChecked="True" Margin="0,0,0,10" KeyboardNavigation.TabIndex="68" Checked="LyricScrollCheckBox_Changed" Unchecked="LyricScrollCheckBox_Changed" IsTabStop="True"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="下载设置" Margin="0,0,0,15">
                                <StackPanel Margin="10">
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="下载目录：" Target="{Binding ElementName=DownloadPathBox}"
                                               VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                                        <TextBox x:Name="DownloadPathBox" AutomationProperties.Name="下载目录" Width="320" Height="28" Margin="0,0,8,0" KeyboardNavigation.TabIndex="69" LostKeyboardFocus="DownloadPathBox_LostKeyboardFocus" PreviewKeyDown="SettingsPathBox_PreviewKeyDown" IsTabStop="True"/>
                                        <Button x:Name="BrowseDownloadPathBtn" Content="浏览..." Width="80" Height="28" KeyboardNavigation.TabIndex="70" Click="BrowseDownloadPathBtn_Click" IsTabStop="True"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Label Content="默认下载音质：" Target="{Binding ElementName=DownloadQualityCombo}"
                                               VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="DownloadQualityCombo" AutomationProperties.Name="默认下载音质" Width="180" Height="28" KeyboardNavigation.TabIndex="71"
                                                  SelectionChanged="DownloadQualityCombo_SelectionChanged" IsTabStop="True">
                                            <ComboBoxItem Content="128k 标准" Tag="128k" IsSelected="True"/>
                                            <ComboBoxItem Content="192k" Tag="192k"/>
                                            <ComboBoxItem Content="320k 高品质" Tag="320k"/>
                                            <ComboBoxItem Content="FLAC 无损" Tag="flac"/>
                                            <ComboBoxItem Content="FLAC 24bit 高解析" Tag="flac24bit"/>
                                            <ComboBoxItem Content="Hi-Res 高解析" Tag="hires"/>
                                            <ComboBoxItem Content="杜比全景声" Tag="atmos"/>
                                            <ComboBoxItem Content="杜比全景声增强" Tag="atmos_plus"/>
                                            <ComboBoxItem Content="母带级" Tag="master"/>
                                            <ComboBoxItem Content="至臻音效" Tag="jyeffect"/>
                                            <ComboBoxItem Content="至臻全景声" Tag="sky"/>
                                            <ComboBoxItem Content="杜比音效" Tag="dolby"/>
                                            <ComboBoxItem Content="至臻母带" Tag="jymaster"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <CheckBox x:Name="DownloadLyricCheckBox" Content="下载时同时下载歌词" VerticalAlignment="Center" Margin="0,0,20,0" FontWeight="SemiBold" KeyboardNavigation.TabIndex="72"
                                                  Checked="DownloadSetting_Changed" Unchecked="DownloadSetting_Changed" IsTabStop="True"/>
                                        <CheckBox x:Name="DownloadNameQualityCheckBox" Content="文件名包含音质（如[mp3]）" VerticalAlignment="Center" KeyboardNavigation.TabIndex="73"
                                                  Checked="DownloadSetting_Changed" Unchecked="DownloadSetting_Changed" IsTabStop="True"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Label Content="命名顺序：" Target="{Binding ElementName=DownloadNameOrderCombo}"
                                               VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="DownloadNameOrderCombo" AutomationProperties.Name="歌曲命名顺序" Width="180" Height="28" KeyboardNavigation.TabIndex="74"
                                                  SelectionChanged="DownloadNameOrderCombo_SelectionChanged" IsTabStop="True">
                                            <ComboBoxItem Content="艺术家 - 歌名" Tag="ArtistTitle"/>
                                            <ComboBoxItem Content="歌名 - 艺术家" Tag="TitleArtist"/>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="数据目录" Margin="0,0,0,15">
                                <StackPanel Margin="10">
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="数据目录：" Target="{Binding ElementName=DataDirBox}"
                                               VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                                        <TextBox x:Name="DataDirBox" AutomationProperties.Name="数据目录" Width="320" Height="28" Margin="0,0,8,0" KeyboardNavigation.TabIndex="75" IsReadOnly="True" IsTabStop="True"/>
                                        <Button x:Name="BrowseDataDirBtn" Content="浏览..." Width="80" Height="28" KeyboardNavigation.TabIndex="76" Click="BrowseDataDirBtn_Click" IsTabStop="True"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="缓存管理" Margin="0,0,0,15">
                                <StackPanel Margin="10">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button x:Name="ClearCacheBtn" Content="清理缓存" Width="110" Height="28" KeyboardNavigation.TabIndex="77" Click="ClearCacheBtn_Click" IsTabStop="True"/>
                                    </StackPanel>
                                    <TextBlock Text="清理歌曲播放时的临时缓存文件（%TEMP% 下的 lxmusic 缓存）与第三方播放器临时文件；正在播放中的文件不会被删除。"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="无障碍设置">
                                <StackPanel Margin="10">
                                    <CheckBox x:Name="EnableScreenReaderCheckBox" Content="启用屏幕阅读器支持" IsChecked="True" Margin="0,0,0,10" KeyboardNavigation.TabIndex="78" IsTabStop="True"/>
                                    <CheckBox x:Name="EnableVoiceAnnouncementCheckBox" Content="启用语音朗读提示" IsChecked="True" Margin="0,0,0,10" KeyboardNavigation.TabIndex="79" Checked="VoiceAnnouncementCheckBox_Changed" Unchecked="VoiceAnnouncementCheckBox_Changed" IsTabStop="True"/>
                                    <TextBlock x:Name="SpeechBackendText" Text="朗读后端：自动检测" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Label Content="朗读语音：" Target="{Binding ElementName=VoiceCombo}"
                                               VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="VoiceCombo" AutomationProperties.Name="朗读语音" Width="220" Height="28" KeyboardNavigation.TabIndex="80" SelectionChanged="VoiceCombo_SelectionChanged" IsTabStop="True"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Label Content="朗读语速：" Target="{Binding ElementName=SpeechRateCombo}"
                                               VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="SpeechRateCombo" AutomationProperties.Name="朗读语速" Width="150" Height="28" KeyboardNavigation.TabIndex="81" SelectionChanged="SpeechRateCombo_SelectionChanged" IsTabStop="True">
                                            <ComboBoxItem Content="慢" Tag="0.75"/>
                                            <ComboBoxItem Content="标准" Tag="1" IsSelected="True"/>
                                            <ComboBoxItem Content="快" Tag="1.25"/>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="快捷键设置" Margin="0,15,0,0">
                                <StackPanel Margin="10">
                                    <TextBlock Text="快捷键为全局快捷键，程序在后台也能使用。选中下方列表项后按回车修改快捷键，按 Delete 清除，Esc 取消修改。"
                                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <local:SingleReadListBox x:Name="HotkeyListBox" Height="260" KeyboardNavigation.TabIndex="82"
                                             AutomationProperties.Name="快捷键"
                                             KeyDown="HotkeyListBox_KeyDown" IsTabStop="False" HorizontalContentAlignment="Stretch">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <!-- 显式设置单一读屏名称，避免读屏把名称与内部多个文本块重复朗读两次 -->
                                                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleText}"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ActionName}" Width="100" FontWeight="SemiBold"/>
                                                    <TextBlock Text="：" />
                                                    <TextBlock Text="{Binding ShortcutText}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </local:SingleReadListBox>
                                    <Button x:Name="ResetHotkeysBtn" Content="恢复默认快捷键" KeyboardNavigation.TabIndex="83" Margin="0,8,0,0" HorizontalAlignment="Left" Click="ResetHotkeysBtn_Click" IsTabStop="True"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </local:SafeScrollViewer>
                </TabItem>

                <!-- ===== 标签6：下载管理 ===== -->
                <TabItem Header="下载管理"
                         KeyboardNavigation.TabNavigation="Cycle"
                         KeyboardNavigation.DirectionalNavigation="None">
                    <local:SafeScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" IsTabStop="False">
                        <StackPanel Margin="15">
                            <TextBlock Text="下载管理" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="DownloadCancelBtn" Content="取消选中" Width="90" Height="28" Margin="0,0,5,0" KeyboardNavigation.TabIndex="70" Click="DownloadCancelBtn_Click" IsTabStop="True"/>
                                <Button x:Name="DownloadRetryBtn" Content="重试" Width="70" Height="28" Margin="0,0,5,0" KeyboardNavigation.TabIndex="72" Click="DownloadRetryBtn_Click" IsTabStop="True"/>
                                <Button x:Name="DownloadOpenFolderBtn" Content="打开下载文件夹" Width="120" Height="28" Margin="0,0,5,0" KeyboardNavigation.TabIndex="73" Click="DownloadOpenFolderBtn_Click" IsTabStop="True"/>
                                <Button x:Name="DownloadClearDoneBtn" Content="清空已完成" Width="100" Height="28" KeyboardNavigation.TabIndex="74" Click="DownloadClearDoneBtn_Click" IsTabStop="True"/>
                            </StackPanel>

                            <GroupBox Header="下载任务">
                                <local:SingleReadListBox x:Name="DownloadTaskList" MinHeight="420" KeyboardNavigation.TabIndex="75"
                                         AutomationProperties.Name="下载任务"
                                         IsTabStop="False">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" Width="380" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ProgressText}" Width="70"/>
                                                <TextBlock Text="{Binding StatusText}" Width="70"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </local:SingleReadListBox>
                            </GroupBox>
                        </StackPanel>
                    </local:SafeScrollViewer>
                </TabItem>

            </TabControl>

            <!-- ===== 右侧信息面板 ===== -->
            <StackPanel Grid.Column="1" Margin="10" x:Name="RightPanel">
                <GroupBox Header="正在播放">
                    <StackPanel>
                        <TextBlock x:Name="CurrentTitle" Text="未播放" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock x:Name="CurrentArtist" Text="" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock x:Name="CurrentAlbum" Text="" TextWrapping="Wrap"/>
                        <TextBlock x:Name="CurrentPlayModeText" Text="播放模式：顺序播放" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock x:Name="PositionText" Text="00:00 / 00:00" Margin="0,8,0,0"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </Grid>

        <!-- ===== 底部状态栏 ===== -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="TimeText" Text=""/>
            </StatusBarItem>
        </StatusBar>

        <!-- 无障碍实时区域：NVDA/讲述人/JAWS 播报用 -->
        <local:AnnouncementTextBlock x:Name="LiveRegion" Width="1" Height="1" Opacity="0" IsHitTestVisible="False"
                   AutomationProperties.LiveSetting="Polite"
                   VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
    </Grid>
</Window>



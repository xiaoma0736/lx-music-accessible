<Window x:Class="LXMusicAccessible.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LXMusicAccessible.App"
        mc:Ignorable="d"
        Title="落雪音乐 无障碍版" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="落雪音乐无障碍版主窗口"
        KeyboardNavigation.TabNavigation="Continue"
        KeyboardNavigation.DirectionalNavigation="None"
        PreviewKeyDown="Window_PreviewKeyDown" KeyDown="Window_KeyDown" KeyUp="Window_KeyUp">

    <Window.Resources>
        <!-- 音源列表右键菜单 -->
        <ContextMenu x:Key="SourceContextMenu" AutomationProperties.Name="音源操作菜单">
            <MenuItem Header="设为默认" AutomationProperties.Name="设为默认" Click="SourceMenu_SetDefault_Click"/>
            <MenuItem Header="启用" AutomationProperties.Name="启用" Click="SourceMenu_Enable_Click"/>
            <MenuItem Header="禁用" AutomationProperties.Name="禁用" Click="SourceMenu_Disable_Click"/>
            <Separator/>
            <MenuItem Header="检测有效性" AutomationProperties.Name="检测有效性" Click="SourceMenu_Test_Click"/>
            <MenuItem Header="编辑" AutomationProperties.Name="编辑" Click="SourceMenu_Edit_Click"/>
            <MenuItem Header="删除" AutomationProperties.Name="删除" Click="SourceMenu_Delete_Click"/>
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 菜单栏（仅 Alt 访问，不参与 Tab 导航） ===== -->
        <Menu Grid.Row="0" AutomationProperties.Name="主菜单" x:Name="MainMenu"
              KeyboardNavigation.TabNavigation="None">
            <MenuItem Header="文件(_F)" AutomationProperties.Name="文件菜单">
                <MenuItem Header="隐藏/显示窗口(_H)" AutomationProperties.Name="隐藏显示窗口" Click="HideShowWindowMenu_Click"/>
                <Separator/>
                <MenuItem Header="退出(_X)" AutomationProperties.Name="退出" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="播放(_P)" AutomationProperties.Name="播放菜单">
                <MenuItem x:Name="MenuPlayPauseItem" Header="播放/暂停（F5）" AutomationProperties.Name="播放暂停" Click="PlayPauseButton_Click"/>
                <MenuItem Header="停止（F6）" AutomationProperties.Name="停止" Click="StopButton_Click"/>
                <MenuItem Header="上一首" AutomationProperties.Name="上一首" Click="PreviousButton_Click"/>
                <MenuItem Header="下一首" AutomationProperties.Name="下一首" Click="NextButton_Click"/>
                <Separator/>
                <MenuItem Header="快退十秒（F7）" AutomationProperties.Name="快退十秒" Click="RewindMenu_Click"/>
                <MenuItem Header="快进十秒（F8）" AutomationProperties.Name="快进十秒" Click="ForwardMenu_Click"/>
                <Separator/>
                <MenuItem Header="音量减（F9）" AutomationProperties.Name="音量减" Click="VolumeDownMenu_Click"/>
                <MenuItem Header="音量加（F10）" AutomationProperties.Name="音量加" Click="VolumeUpMenu_Click"/>
                <MenuItem Header="上一个播放设备（F11）" AutomationProperties.Name="上一个播放设备" Click="PrevDeviceMenu_Click"/>
                <MenuItem Header="下一个播放设备（F12）" AutomationProperties.Name="下一个播放设备" Click="NextDeviceMenu_Click"/>
                <Separator/>
                <MenuItem Header="歌词延后（Shift+F7）" AutomationProperties.Name="歌词延后" Click="LyricDelayMenu_Click"/>
                <MenuItem Header="歌词提前（Shift+F8）" AutomationProperties.Name="歌词提前" Click="LyricAdvanceMenu_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuPlayModeItem" Header="播放模式（F1）" AutomationProperties.Name="播放模式" Click="PlayModeButton_Click"/>
                <MenuItem Header="下载（F2）" AutomationProperties.Name="下载" Click="DownloadMenu_Click"/>
            </MenuItem>
            <MenuItem Header="浏览(_B)" AutomationProperties.Name="浏览菜单">
                <MenuItem Header="搜索(_S)" AutomationProperties.Name="搜索" Click="MenuNavigateToSearch"/>
                <MenuItem Header="播放列表(_L)" AutomationProperties.Name="播放列表" Click="MenuNavigateToPlaylist"/>
                <MenuItem Header="导入个人歌单(_I)" AutomationProperties.Name="导入个人歌单" Click="MenuNavigateToImport"/>
                <MenuItem Header="分类歌单(_C)" AutomationProperties.Name="分类歌单" Click="MenuNavigateToCategory"/>
                <MenuItem Header="排行榜(_R)" AutomationProperties.Name="排行榜" Click="MenuNavigateToRanking"/>
                <MenuItem Header="歌词(_G)" AutomationProperties.Name="歌词" Click="MenuNavigateToLyrics"/>
                <MenuItem Header="下载管理(_D)" AutomationProperties.Name="下载管理" Click="MenuNavigateToDownload"/>
            </MenuItem>
            <MenuItem Header="设置(_T)" AutomationProperties.Name="设置菜单">
                <MenuItem Header="设置(_S)" AutomationProperties.Name="设置" Click="MenuNavigateToSettings"/>
                <MenuItem Header="音源管理(_I)" AutomationProperties.Name="音源管理" Click="MenuNavigateToSources"/>
            </MenuItem>
            <MenuItem Header="帮助(_H)" AutomationProperties.Name="帮助菜单">
                <MenuItem Header="使用说明(_U)" AutomationProperties.Name="使用说明" Click="UserGuide_Click"/>
                <MenuItem Header="赞助(_S)" AutomationProperties.Name="赞助" Click="Sponsor_Click"/>
                <MenuItem Header="关于(_A)" AutomationProperties.Name="关于" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- ===== 主内容区 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0" x:Name="MainTabControl"
                        AutomationProperties.Name="主标签页"
                        KeyboardNavigation.TabNavigation="Local"
                        KeyboardNavigation.DirectionalNavigation="Contained"
                        SelectionChanged="MainTabControl_SelectionChanged"
                        Margin="5">
                <!-- ===== 标签1：搜索 ===== -->
                <TabItem Header="搜索" AutomationProperties.Name="搜索标签页"
                         KeyboardNavigation.TabNavigation="Cycle"
                         KeyboardNavigation.DirectionalNavigation="None">
                    <local:SafeScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" IsTabStop="False">
                        <StackPanel Margin="15">
                            <TextBlock Text="搜索音乐" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"
                                       AutomationProperties.Name="搜索标题"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Label Content="音源：" Target="{Binding ElementName=SearchSourceCombo}"
                                       VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                                <ComboBox x:Name="SearchSourceCombo" Width="140" Height="28" Margin="0,0,15,0" KeyboardNavigation.TabIndex="10"
                                          AutomationProperties.Name="搜索音源" IsTabStop="True">
                                    <ComboBoxItem Content="全部音源" Tag="all" IsSelected="True"/>
                                    <ComboBoxItem Content="网易云音乐" Tag="netease"/>
                                    <ComboBoxItem Content="QQ音乐" Tag="qq"/>
                                    <ComboBoxItem Content="酷狗音乐" Tag="kg"/>
                                    <ComboBoxItem Content="酷我音乐" Tag="kw"/>
                                    <ComboBoxItem Content="咪咕音乐" Tag="migu"/>
                                </ComboBox>

                                <Label Content="类型：" Target="{Binding ElementName=SearchTypeComboBox}"
                                       VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                                <ComboBox x:Name="SearchTypeComboBox" Width="100" Height="28" KeyboardNavigation.TabIndex="11"
                                          AutomationProperties.Name="搜索类型" IsTabStop="True">
                                    <ComboBoxItem Content="歌曲" Tag="song" IsSelected="True"/>
                                    <ComboBoxItem Content="歌手" Tag="artist"/>
                                    <ComboBoxItem Content="专辑" Tag="album"/>
                                </ComboBox>
                            </StackPanel>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SearchBox" Grid.Column="0" Height="30" Margin="0,0,10,0" KeyboardNavigation.TabIndex="12"
                                         AutomationProperties.Name="搜索输入框"
                                         AutomationProperties.HelpText="输入搜索关键词，按回车搜索；上下光标查看搜索历史"
                                         KeyDown="SearchBox_KeyDown" IsTabStop="True"/>
                                <Button x:Name="SearchButton" Grid.Column="1" Content="搜索" Width="80" Height="30" KeyboardNavigation.TabIndex="13"
                                        AutomationProperties.Name="搜索按钮" Click="SearchButton_Click" IsTabStop="True"/>
                                <Button x:Name="SearchClearButton" Grid.Column="2" Content="清空" Width="80" Height="30" KeyboardNavigation.TabIndex="14"
                                        AutomationProperties.Name="清空搜索" Click="SearchClearButton_Click" IsTabStop="True"/>
                            </Grid>

                            <GroupBox Header="搜索结果" AutomationProperties.Name="搜索结果区域">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <local:SingleReadListBox x:Name="SearchResultsList" Grid.Row="0" MinHeight="350" KeyboardNavigation.TabIndex="15"
                                            
                                             ContextMenuOpening="SongList_ContextMenuOpening"
                                             PreviewMouseRightButtonDown="SongList_PreviewMouseRightButtonDown"
                                             AutomationProperties.Name="搜索结果列表"
                                             AutomationProperties.HelpText="上下方向键浏览，回车或空格播放"
                                             MouseDoubleClick="SearchResultsList_MouseDoubleClick"
                                             KeyDown="SearchResultsList_KeyDown" IsTabStop="False">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" Width="280" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Artist}" Width="180" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Album}" Width="180" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Duration}" Width="70"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </local:SingleReadListBox>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                        <local:InvisibleToScreenReaderButton x:Name="SearchPrevPageBtn" Content="上一页" Width="80" Height="28" KeyboardNavigation.TabIndex="16"
                                                AutomationProperties.Name="搜索上一页" Click="SearchPrevPageBtn_Click" IsTabStop="False"/>
                                        <local:InvisibleToScreenReaderTextBlock x:Name="SearchPageInfo" Text="第 1 页" VerticalAlignment="Center" Margin="10,0"/>
                                        <local:InvisibleToScreenReaderButton x:Name="SearchNextPageBtn" Content="下一页" Width="80" Height="28" KeyboardNavigation.TabIndex="17"
                                                AutomationProperties.Name="搜索下一页" Click="SearchNextPageBtn_Click" IsTabStop="False"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </local:SafeScrollViewer>
                </TabItem>
                                <!-- ===== 标签2：播放列表（本地收藏/在线收藏） ===== -->
                                <TabItem Header="播放列表" AutomationProperties.Name="播放列表标签页"
                         KeyboardNavigation.TabNavigation="Cycle"
                         KeyboardNavigation.DirectionalNavigation="None">
                    <local:SafeScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" IsTabStop="False">
                        <StackPanel Margin="15">
                            <TextBlock Text="音乐收藏" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"
                                       AutomationProperties.Name="播放列表标题"/>

                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="在线音乐收藏：可收藏单曲或整个歌单，支持新建歌单分组管理。"
                                           TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.Name="在线收藏说明"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="NewOnlinePlaylistBtn" Content="新建歌单" Width="90" Height="28" Margin="0,0,5,0" KeyboardNavigation.TabIndex="29"
                                            AutomationProperties.Name="新建在线歌单" Click="NewOnlinePlaylistBtn_Click" IsTabStop="True"/>
                                    <Button x:Name="RenameOnlinePlaylistBtn" Content="重命名歌单" Width="100" Height="28" Margin="0,0,5,0" KeyboardNavigation.TabIndex="30"
                                            AutomationProperties.Name="重命名在线歌单" Click="RenameOnlinePlaylistBtn_Click" IsTabStop="True"/>
                                    <Button x:Name="DeleteOnlinePlaylistBtn" Content="删除歌单" Width="90" Height="28" Margin="0,0,5,0" KeyboardNavigation.TabIndex="31"
                                            AutomationProperties.Name="删除在线歌单" Click="DeleteOnlinePlaylistBtn_Click" IsTabStop="True"/>
                                    <Button x:Name="FavRefreshBtn" Content="刷新" Width="70" Height="28" Margin="0,0,5,0" KeyboardNavigation.TabIndex="32"
                                            AutomationProperties.Name="刷新在线收藏" Click="FavRefreshBtn_Click" IsTabStop="True"/>
                                    <Button x:Name="FavRemoveBtn" Content="从歌单移除" Width="100" Height="28" Margin="0,0,5,0" KeyboardNavigation.TabIndex="33"
                                            AutomationProperties.Name="从歌单移除选中歌曲" Click="FavRemoveBtn_Click" IsTabStop="True"/>
                                    <Button x:Name="FavClearBtn" Content="清空歌单" Width="90" Height="28" KeyboardNavigation.TabIndex="34"
                                            AutomationProperties.Name="清空当前在线歌单" Click="FavClearBtn_Click" IsTabStop="True"/>
                                    <TextBlock x:Name="FavoriteCountText" Text="共 0 首" VerticalAlignment="Center" Margin="10,0,0,0"
                                               AutomationProperties.Name="在线歌单歌曲数量"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="250"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <GroupBox Grid.Column="0" Header="在线歌单" AutomationProperties.Name="在线歌单列表区域" Margin="0,0,8,0">
                                        <ListBox x:Name="OnlinePlaylistList" MinHeight="300" DisplayMemberPath="Name" KeyboardNavigation.TabIndex="35"
                                                 AutomationProperties.Name="在线歌单列表"
                                                 AutomationProperties.HelpText="上下方向键选择歌单，回车查看歌曲，Delete删除歌单"
                                                 SelectionChanged="OnlinePlaylistList_SelectionChanged"
                                                 KeyDown="OnlinePlaylistList_KeyDown" IsTabStop="False">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                    </GroupBox>
                                    <GroupBox Grid.Column="1" Header="在线歌曲" AutomationProperties.Name="在线歌曲区域">
                                        <local:SingleReadListBox x:Name="FavoriteSongsList" MinHeight="300" KeyboardNavigation.TabIndex="36"
                                            ContextMenuOpening="SongList_ContextMenuOpening"
                                            PreviewMouseRightButtonDown="SongList_PreviewMouseRightButtonDown"
                                            AutomationProperties.Name="在线歌曲列表"
                                            AutomationProperties.HelpText="上下方向键浏览，回车或空格播放，Delete从歌单移除"
                                            MouseDoubleClick="FavoriteSongsList_MouseDoubleClick"
                                            KeyDown="FavoriteSongsList_KeyDown" IsTabStop="False">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" Width="280" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Artist}" Width="180" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Album}" Width="180" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Duration}" Width="70"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </local:SingleReadListBox>
                                    </GroupBox>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </local:SafeScrollViewer>
                </TabItem>

                <!-- ===== 标签：导入个人歌单（并入主界面） ===== -->
                <TabItem Header="导入个人歌单" AutomationProperties.Name="导入个人歌单标签页"
                         KeyboardNavigation.TabNavigation="Cycle"
                         KeyboardNavigation.DirectionalNavigation="None">
                    <ContentControl x:Name="PlaylistImportHost"/>
                </TabItem>

<!-- ===== 标签3：分类歌单 ===== -->
                <TabItem Header="分类歌单" AutomationProperties.Name="分类歌单标签页"
                         KeyboardNavigation.TabNavigation="Cycle"
                         KeyboardNavigation.DirectionalNavigation="None">
                    <local:SafeScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" IsTabStop="False">
                        <StackPanel Margin="15">
                            <TextBlock Text="分类歌单" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"
                                       AutomationProperties.Name="分类歌单标题"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Label Content="音源：" Target="{Binding ElementName=CategorySourceCombo}"
                                       VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                                <ComboBox x:Name="CategorySourceCombo" Width="140" Height="28" Margin="0,0,10,0" KeyboardNavigation.TabIndex="31"
                                          AutomationProperties.Name="歌单音源" AutomationProperties.HelpText="上下方向键选择音源，按 Enter 或刷新按钮加载分类" SelectionChanged="CategorySourceCombo_SelectionChanged" KeyDown="CategorySourceCombo_KeyDown" IsTabStop="True">
                                    <ComboBoxItem Content="网易云音乐" Tag="netease" IsSelected="True"/>
                                    <ComboBoxItem Content="QQ音乐" Tag="qq"/>
                                    <ComboBoxItem Content="酷狗音乐" Tag="kg"/>
                                    <ComboBoxItem Content="酷我音乐" Tag="kw"/>
                                    <ComboBoxItem Content="咪咕音乐" Tag="migu"/>
                                </ComboBox>
                                <Button x:Name="CategoryRefreshBtn" Content="刷新" Width="70" Height="28" KeyboardNavigation.TabIndex="32"
                                        AutomationProperties.Name="刷新分类歌单" Click="CategoryRefreshBtn_Click" IsTabStop="True"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <GroupBox Grid.Column="0" Header="分类" AutomationProperties.Name="分类列表区域">
                                    <ListBox x:Name="CategoryList" KeyboardNavigation.TabIndex="33"
                                             DisplayMemberPath="Name"
                                             AutomationProperties.Name="分类列表"
                                             AutomationProperties.HelpText="上下方向键选择分类，按 Enter 加载歌单"
                                             SelectionChanged="CategoryList_SelectionChanged"
                                             KeyDown="CategoryList_KeyDown" IsTabStop="False">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </GroupBox>
                                <GroupBox Grid.Column="1" Header="歌单" Margin="10,0,0,0"
                                          AutomationProperties.Name="歌单列表区域">
                                    <ListBox x:Name="CategoryPlaylistsListBox" KeyboardNavigation.TabIndex="34"
                                             DisplayMemberPath="Name"
                                             AutomationProperties.Name="歌单列表"
                                             AutomationProperties.HelpText="上下方向键选择歌单，回车查看歌曲"
                                             SelectionChanged="CategoryPlaylistsListBox_SelectionChanged"
                                             KeyDown="CategoryPlaylistsListBox_KeyDown"
                                             ContextMenuOpening="PlaylistList_ContextMenuOpening" IsTabStop="False">
                                        <ListBox.ContextMenu>
                                            <ContextMenu AutomationProperties.Name="歌单操作菜单" PreviewKeyUp="ContextMenu_PreviewKeyUp">
                                                <MenuItem Header="收藏整个歌单到在线收藏" AutomationProperties.Name="收藏整个歌单到在线收藏" Click="CategoryPlaylist_Favorite_Click"/>
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </GroupBox>
                                <GroupBox Grid.Column="2" Header="歌曲" Margin="10,0,0,0"
                                          AutomationProperties.Name="歌单歌曲区域">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <local:SingleReadListBox x:Name="CategorySongsList" Grid.Row="0" KeyboardNavigation.TabIndex="35"
                                                
                                                 ContextMenuOpening="SongList_ContextMenuOpening"
                                                 PreviewMouseRightButtonDown="SongList_PreviewMouseRightButtonDown"
                                                 AutomationProperties.Name="歌单歌曲列表"
                                                 AutomationProperties.HelpText="上下方向键浏览，回车或空格播放"
                                             MouseDoubleClick="CategorySongsList_MouseDoubleClick"
                                                 KeyDown="CategorySongsList_KeyDown" IsTabStop="False">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" Width="220" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Artist}" Width="150" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Album}" Width="140" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Duration}" Width="60"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </local:SingleReadListBox>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                            <local:InvisibleToScreenReaderButton x:Name="CategoryPrevPageBtn" Content="上一页" Width="80" Height="28" KeyboardNavigation.TabIndex="36"
                                                    AutomationProperties.Name="歌单上一页" Click="CategoryPrevPageBtn_Click" IsTabStop="False"/>
                                            <local:InvisibleToScreenReaderTextBlock x:Name="CategoryPageInfo" Text="第 1 页" VerticalAlignment="Center" Margin="10,0"/>
                                            <local:InvisibleToScreenReaderButton x:Name="CategoryNextPageBtn" Content="下一页" Width="80" Height="28" KeyboardNavigation.TabIndex="36"
                                                    AutomationProperties.Name="歌单下一页" Click="CategoryNextPageBtn_Click" IsTabStop="False"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>
                            </Grid>
                        </StackPanel>
                    </local:SafeScrollViewer>
                </TabItem>
                <!-- ===== 标签4：排行榜 ===== -->
                <TabItem Header="排行榜" AutomationProperties.Name="排行榜标签页"
                         KeyboardNavigation.TabNavigation="Cycle"
                         KeyboardNavigation.DirectionalNavigation="None">
                    <local:SafeScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" IsTabStop="False">
                        <StackPanel Margin="15">
                            <TextBlock Text="音乐排行榜" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"
                                       AutomationProperties.Name="排行榜标题"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Label Content="音源：" Target="{Binding ElementName=RankingSourceCombo}"
                                       VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                                <ComboBox x:Name="RankingSourceCombo" Width="140" Height="28" Margin="0,0,10,0" KeyboardNavigation.TabIndex="40"
                                          AutomationProperties.Name="排行榜音源" AutomationProperties.HelpText="上下方向键选择音源，按 Enter 或刷新按钮加载排行榜" SelectionChanged="RankingSourceCombo_SelectionChanged" KeyDown="RankingSourceCombo_KeyDown" IsTabStop="True">

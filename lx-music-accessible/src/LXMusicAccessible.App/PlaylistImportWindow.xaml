<Window x:Class="LXMusicAccessible.App.PlaylistImportWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LXMusicAccessible.App"
             Title="导入个人歌单"
             Width="760" Height="680" MinWidth="560" MinHeight="460"
             WindowStartupLocation="CenterOwner"
             ResizeMode="CanResize"
             ShowInTaskbar="False"
             PreviewKeyDown="Window_PreviewKeyDown"
             Closing="Window_Closing">
    <local:SafeScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" IsTabStop="False">
        <StackPanel Margin="20">
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Text="导入个人歌单"/>

            <!-- 平台选择 -->
            <TextBlock Text="请选择音乐平台："/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                <Button x:Name="PlatformNeteaseBtn" Content="网易云" Width="90" Height="30" Margin="0,0,6,0"
                        KeyboardNavigation.TabIndex="10"
                        Click="PlatformBtn_Click" Tag="netease" IsTabStop="True"/>
                <Button x:Name="PlatformQqBtn" Content="QQ音乐" Width="90" Height="30" Margin="0,0,6,0"
                        KeyboardNavigation.TabIndex="11"
                        Click="PlatformBtn_Click" Tag="qq" IsTabStop="True"/>
                <Button x:Name="PlatformKgBtn" Content="酷狗" Width="90" Height="30" Margin="0,0,6,0"
                        KeyboardNavigation.TabIndex="12"
                        Click="PlatformBtn_Click" Tag="kg" IsTabStop="True"/>
                <Button x:Name="PlatformKwBtn" Content="酷我" Width="90" Height="30"
                        KeyboardNavigation.TabIndex="13"
                        Click="PlatformBtn_Click" Tag="kw" IsTabStop="True"/>
            </StackPanel>

            <!-- 账号状态与登录 -->
            <TextBlock x:Name="AccountStatusText" Text="未登录" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="WebLoginBtn" Content="网页登录" Width="100" Height="30" Margin="0,0,6,0"
                        KeyboardNavigation.TabIndex="20"
                        Click="WebLoginBtn_Click" IsTabStop="True"/>
                <Button x:Name="CookieLoginBtn" Content="粘贴Cookie登录" Width="130" Height="30" Margin="0,0,6,0"
                        KeyboardNavigation.TabIndex="21"
                        Click="CookieLoginBtn_Click" IsTabStop="True"/>
                <Button x:Name="KugouQrLoginBtn" Content="酷狗APP扫码登录" Width="150" Height="30" Margin="0,0,6,0"
                        KeyboardNavigation.TabIndex="22"
                        Click="KugouQrLoginBtn_Click" IsTabStop="True" Visibility="Collapsed"/>
                <Button x:Name="LogoutBtn" Content="退出登录" Width="100" Height="30"
                        KeyboardNavigation.TabIndex="23"
                        Click="LogoutBtn_Click" IsTabStop="True" Visibility="Collapsed"/>
            </StackPanel>

            <!-- 粘贴 Cookie 区域 -->
            <Border x:Name="CookieArea" Background="#EEEEEE" BorderBrush="#CCCCCC" BorderThickness="1"
                    Padding="10" Margin="0,0,0,8" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="请在电脑浏览器中登录音乐平台网页版，按 F12 打开开发者工具，在控制台输入 document.cookie 回车，把显示的 Cookie 完整复制并粘贴到下面，然后点击提交。"
                               TextWrapping="Wrap"/>
                    <TextBox x:Name="CookieBox" Height="90" AcceptsReturn="True" TextWrapping="Wrap"
                             AutomationProperties.Name="Cookie"
                             VerticalScrollBarVisibility="Auto" Margin="0,8,0,8" IsTabStop="True"/>
                    <Button x:Name="CookieSubmitBtn" Content="提交Cookie" Width="110" Height="28"
                            KeyboardNavigation.TabIndex="23"
                            Click="CookieSubmitBtn_Click" IsTabStop="True"/>
                </StackPanel>
            </Border>

            <!-- 我的歌单 -->
            <Button x:Name="LoadPlaylistsBtn" Content="获取我的歌单" Width="130" Height="30" Margin="0,6,0,6"
                    KeyboardNavigation.TabIndex="30"
                    Click="LoadPlaylistsBtn_Click" IsTabStop="True" Visibility="Collapsed"/>
            <TextBlock x:Name="PlaylistListHintText" Text="按上下方向键浏览歌单，按回车打开该歌单的歌曲列表，按 Ctrl+空格 选中或取消，可点击下方按钮导入所选歌单。"
                       TextWrapping="Wrap" Margin="0,0,0,4"
                       Visibility="Collapsed"/>
            <local:SingleReadListBox x:Name="MyPlaylistsList" MinHeight="160" MaxHeight="220" Margin="0,0,0,6"
                     AutomationProperties.Name="我的歌单"
                     KeyboardNavigation.TabIndex="31"
                     SelectionMode="Extended" Visibility="Collapsed" IsTabStop="False"
                     KeyDown="MyPlaylistsList_KeyDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </local:SingleReadListBox>

            <!-- 歌曲预览区（回车打开歌单时显示） -->
            <StackPanel x:Name="SongPreviewArea" Visibility="Collapsed" Margin="0,6,0,0">
                <TextBlock x:Name="SongPreviewHeaderText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" Text="歌曲预览"/>
                <local:SingleReadListBox x:Name="PlaylistSongsList" MinHeight="200" MaxHeight="300" Margin="0,0,0,6"
                                         AutomationProperties.Name="歌单歌曲"
                                         KeyboardNavigation.TabIndex="32"
                                         IsTabStop="False">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </local:SingleReadListBox>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BackToPlaylistsBtn" Content="返回歌单列表" Width="120" Height="30" Margin="0,0,6,0"
                            KeyboardNavigation.TabIndex="45"
                            Click="BackToPlaylistsBtn_Click" IsTabStop="True"/>
                    <Button x:Name="ImportThisPlaylistBtn" Content="导入此歌单" Width="110" Height="30" Margin="0,0,6,0"
                            KeyboardNavigation.TabIndex="46"
                            Click="ImportThisPlaylistBtn_Click" IsTabStop="True"/>
                </StackPanel>
            </StackPanel>

            <!-- 底部按钮 -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="SelectAllBtn" Content="全选/取消全选" Width="110" Height="30" Margin="0,0,6,0"
                        KeyboardNavigation.TabIndex="40"
                        Click="SelectAllBtn_Click" IsTabStop="True" Visibility="Collapsed"/>
                <Button x:Name="ImportSelectedBtn" Content="导入所选歌单" Width="130" Height="30" Margin="0,0,6,0"
                        KeyboardNavigation.TabIndex="41"
                        Click="ImportSelectedBtn_Click" IsTabStop="True" Visibility="Collapsed"/>
            </StackPanel>

            <TextBlock x:Name="ImportStatusText" Text="就绪" TextWrapping="Wrap" Margin="0,8,0,0"
                       AutomationProperties.LiveSetting="Assertive"/>
            <TextBlock Text="提示：歌曲预览中按 Esc 返回歌单列表；在歌单列表中按 Esc 关闭窗口。"
                       TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
    </local:SafeScrollViewer>
</Window>

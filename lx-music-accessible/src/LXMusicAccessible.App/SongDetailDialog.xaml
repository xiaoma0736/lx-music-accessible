<Window x:Class="LXMusicAccessible.App.SongDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LXMusicAccessible.App"
        Title="歌曲详情" Width="640" Height="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" TextWrapping="Wrap"/>
        <local:SingleReadListBox x:Name="DetailsList" Grid.Row="1"
                 AutomationProperties.Name="歌曲详情"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <!-- 列表项名称直接取条目文本，读屏每条只朗读一次 -->
                    <Setter Property="AutomationProperties.Name" Value="{Binding}"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </local:SingleReadListBox>
        <Button Grid.Row="2" Content="关闭" Width="90" Height="30" Margin="0,14,0,0" HorizontalAlignment="Right"
                IsCancel="True" IsDefault="True" Click="Close_Click" IsTabStop="True"/>
    </Grid>
</Window>

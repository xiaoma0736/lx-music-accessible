<Window x:Class="LXMusicAccessible.App.SourceManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LXMusicAccessible.App"
        Title="音源管理"
        Width="760" Height="600" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closed="Window_Closed">
    <Window.Resources>
        <ContextMenu x:Key="SourceContextMenu" PreviewKeyUp="ContextMenu_PreviewKeyUp">
            <MenuItem Header="设为默认" Click="SourceMenu_SetDefault_Click"/>
            <MenuItem Header="启用" Click="SourceMenu_Enable_Click"/>
            <MenuItem Header="禁用" Click="SourceMenu_Disable_Click"/>
            <Separator/>
            <MenuItem Header="检测有效性" Click="SourceMenu_Test_Click"/>
            <MenuItem x:Name="SourceMenuUpdateItem" Header="更新音源接口" Click="SourceMenu_Update_Click"/>
            <MenuItem Header="编辑" Click="SourceMenu_Edit_Click"/>
            <MenuItem Header="删除" Click="SourceMenu_Delete_Click"/>
        </ContextMenu>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="ImportLocalSourceBtn" Content="从本地导入" Width="100" Height="28"
                    Margin="0,0,5,0" Click="ImportLocalSourceBtn_Click"/>
            <Button x:Name="ImportNetworkSourceBtn" Content="从网络导入" Width="100" Height="28"
                    Margin="0,0,5,0" Click="ImportNetworkSourceBtn_Click"/>
            <Button x:Name="RefreshSourcesBtn" Content="刷新" Width="70" Height="28"
                    Click="RefreshSourcesBtn_Click"/>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="音源">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="EmptySourceText" Text="暂无音源" Margin="6,4"
                           AutomationProperties.LiveSetting="Polite"/>
                <local:SingleReadListBox x:Name="SourceList" Grid.Row="1" MinHeight="300"
                                         AutomationProperties.Name="音源"
                                         ContextMenu="{StaticResource SourceContextMenu}"
                                         KeyDown="SourceList_KeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" Width="300" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Version}" Width="90" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding TypeText}" Width="90"/>
                                <TextBlock Text="{Binding StatusText}" Width="120"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </local:SingleReadListBox>
            </Grid>
        </GroupBox>
    </Grid>
</Window>

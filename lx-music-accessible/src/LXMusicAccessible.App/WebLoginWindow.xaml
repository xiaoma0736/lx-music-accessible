<Window x:Class="LXMusicAccessible.App.WebLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="网页登录" Width="980" Height="720"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AutomationProperties.Name="网页登录窗口"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel>
        <!-- 顶部工具栏 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,8,8,6">
            <TextBlock x:Name="PlatformNameText" FontSize="16" FontWeight="Bold" Margin="0,0,14,0"
                       VerticalAlignment="Center" AutomationProperties.Name="当前平台"/>
            <TextBlock x:Name="StatusText" Text="正在加载网页..." VerticalAlignment="Center" Margin="0,0,14,0"
                       AutomationProperties.Name="登录状态"/>
            <Button x:Name="DoneBtn" Content="完成并获取Cookie" Width="150" Height="30"
                    KeyboardNavigation.TabIndex="10" AutomationProperties.Name="完成并获取Cookie"
                    Click="DoneBtn_Click" IsTabStop="True"/>
            <Button x:Name="RefreshBtn" Content="刷新页面" Width="90" Height="30" Margin="6,0,0,0"
                    KeyboardNavigation.TabIndex="11" AutomationProperties.Name="刷新页面"
                    Click="RefreshBtn_Click" IsTabStop="True"/>
            <Button x:Name="CancelBtn" Content="取消" Width="80" Height="30" Margin="6,0,0,0" IsCancel="True"
                    KeyboardNavigation.TabIndex="12" AutomationProperties.Name="取消"
                    Click="CancelBtn_Click" IsTabStop="True"/>
        </StackPanel>

        <!-- 浏览器区域 -->
        <Grid>
            <wv2:WebView2 x:Name="Browser"/>
        </Grid>
    </DockPanel>
</Window>
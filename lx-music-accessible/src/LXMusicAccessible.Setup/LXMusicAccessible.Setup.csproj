<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LXMusicAccessible.Setup</AssemblyName>
    <RootNamespace>LXMusicAccessible.Setup</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.0.0</Version>
    <Product>落雪音乐无障碍版 安装程序</Product>
    <InstallerRuntimeIdentifier Condition="'$(InstallerRuntimeIdentifier)' == ''">win-x64</InstallerRuntimeIdentifier>
    <InstallerPayloadDirectory Condition="'$(InstallerPayloadDirectory)' == ''">$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)installer-payload\$(Configuration)\$(InstallerRuntimeIdentifier)\</InstallerPayloadDirectory>
    <InstallerPayloadArchive Condition="'$(InstallerPayloadArchive)' == ''">$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)installer-payload\$(Configuration)\payload-$(InstallerRuntimeIdentifier).zip</InstallerPayloadArchive>
  </PropertyGroup>

  <ItemGroup>
    <InstallerApplicationProject Include="..\LXMusicAccessible.App\LXMusicAccessible.App.csproj" />
    <ProjectReference Include="@(InstallerApplicationProject)" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\LXMusicAccessible.Core\LXMusicAccessible.Core.csproj" />
    <EmbeddedResource Include="$(InstallerPayloadArchive)" LogicalName="LXMusicAccessible.Setup.payload.zip" />
  </ItemGroup>

  <Target Name="GenerateInstallerPayload"
          BeforeTargets="PrepareResources"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <RemoveDir Directories="$(InstallerPayloadDirectory)" />
    <MakeDir Directories="$(InstallerPayloadDirectory);$([System.IO.Path]::GetDirectoryName('$(InstallerPayloadArchive)'))" />
    <MSBuild Projects="@(InstallerApplicationProject)"
             Targets="Publish"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(InstallerRuntimeIdentifier);SelfContained=true;PublishDir=$([MSBuild]::EnsureTrailingSlash('$(InstallerPayloadDirectory)'))" />
    <ZipDirectory SourceDirectory="$(InstallerPayloadDirectory)"
                  DestinationFile="$(InstallerPayloadArchive)"
                  Overwrite="true" />
  </Target>
</Project>
